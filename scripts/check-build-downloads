#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

failures=0
fail() {
    echo "RESOURCE_SCHEDULER_BUILD_POLICY_FAIL $*"
    failures=$((failures + 1))
}
require_pattern() {
    local file="$1" pattern="$2" label="$3"
    grep -Eq -- "${pattern}" "${file}" || fail "${label}"
}
reject_pattern() {
    local file="$1" pattern="$2" label="$3"
    if grep -Eq -- "${pattern}" "${file}"; then
        fail "${label}"
    fi
}

bash -n scripts/build scripts/check-build-downloads scripts/ci scripts/entry scripts/package scripts/test scripts/test-package-scripts scripts/validate scripts/version \
    scripts/check-migration-policy package/pasturestack-entrypoint.sh package/update-pasturestack-ca

require_pattern Dockerfile.dapper 'ARG UBUNTU_IMAGE=ubuntu:26\.04@sha256:678c6550cc43645e08669028bc177f50be4e7c5b8cca677067b1914d4afc7a03' "dapper_base_not_pinned"
require_pattern Dockerfile.dapper 'ARG GO_VERSION=1\.27\.0' "go_version_not_current"
require_pattern Dockerfile.dapper 'GO_LINUX_AMD64_SHA256=675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685' "go_amd64_sha_not_current"
require_pattern Dockerfile.dapper 'GO_LINUX_ARM64_SHA256=51798d2c42d0e1c6ed7fd9f48728b4193abac9e8aad6dbac2fe96a81f5909bda' "go_arm64_sha_not_current"
require_pattern Dockerfile.dapper 'ARG DOCKER_VERSION=29\.7\.2' "docker_version_not_current"
require_pattern Dockerfile.dapper 'DOCKER_LINUX_AMD64_SHA256=803d433f226db4776e1768fd319fc6c6e4935a456acf84fcc0080818b854bc8f' "docker_amd64_sha_not_current"
require_pattern Dockerfile.dapper 'DOCKER_LINUX_ARM64_SHA256=43d143448adf2c2787704e7d7704fd6d62d367a54c5edaef0a3f75509cb0938d' "docker_arm64_sha_not_current"
require_pattern Dockerfile.dapper 'ARG BUILDX_VERSION=0\.36\.1' "buildx_version_not_current"
require_pattern Dockerfile.dapper 'ARG BUILDX_GIT_COMMIT=1d8dde89b8aba914e05e45366770736fea1fd690' "buildx_commit_not_pinned"
require_pattern Dockerfile.dapper 'ARG BUILDX_SOURCE_SHA256=fb28b5c2a198d05482f0656dfb7ee161240a904e36697bf7108e5d517f23854b' "buildx_source_sha_not_pinned"
require_pattern Dockerfile.dapper 'ARG BUILDX_SECURITY_PATCH_SHA256=9d424e752f24ea0e34ccd80340428f067ae8109204c401c93786a2b0be6ea993' "buildx_patch_sha_not_pinned"
require_pattern Dockerfile.dapper 'git apply --check /usr/share/pasturestack/patches/buildx-security\.patch' "buildx_patch_preflight_missing"
require_pattern Dockerfile.dapper "if grep -F \\$'dep\\\\tgithub.com/docker/docker\\\\t' /usr/share/pasturestack/manifests/buildx-go-version\.txt" "buildx_docker_module_absence_not_enforced"
require_pattern Dockerfile.dapper 'ARG UBUNTU_SNAPSHOT=20260808T000000Z' "dapper_snapshot_not_pinned"
require_pattern Dockerfile.dapper 'ADD --checksum=sha256:6077d27c6b6f8b23590cb01ff877ed8c804a67a5442cc32b5a33da10d2bd0e90' "dapper_ca_bootstrap_not_pinned"
require_pattern Dockerfile.dapper 'COPY ubuntu-apt\.lock /usr/share/pasturestack/manifests/ubuntu-apt\.lock' "dapper_apt_lock_not_copied"
require_pattern Dockerfile.dapper 'gcc="\$\{UBUNTU_APT_GCC_VERSION\}"' "dapper_gcc_not_version_pinned"
require_pattern Dockerfile.dapper 'dpkg-query -W' "dapper_resolved_package_manifest_missing"
require_pattern Makefile 'DAPPER_IMAGE \?= pasturestack-resource-scheduler-dapper:go1\.27\.0-docker29\.7\.2-buildx0\.36\.1' "dapper_identity_not_pinned"
require_pattern Makefile 'UBUNTU_SNAPSHOT \?= 20260808T000000Z' "make_snapshot_not_current"
require_pattern Makefile 'DAPPER_SOURCE \?= /go/src/github\.com/PastureStack/resource-scheduler' "dapper_source_not_canonical"
reject_pattern Dockerfile.dapper 'curl[^|]*\|[[:space:]]*tar' "pipe_to_tar_download"

require_pattern package/Dockerfile 'ARG UBUNTU_IMAGE=ubuntu:26\.04@sha256:678c6550cc43645e08669028bc177f50be4e7c5b8cca677067b1914d4afc7a03' "runtime_base_not_pinned"
require_pattern package/Dockerfile 'ARG UBUNTU_SNAPSHOT=20260808T000000Z' "runtime_snapshot_not_pinned"
require_pattern package/Dockerfile 'Acquire::https::CaInfo "/etc/ssl/certs/ca-certificates\.crt"' "runtime_snapshot_ca_not_enforced"
require_pattern package/Dockerfile 'libcap2-bin="\$\{UBUNTU_APT_LIBCAP2_BIN_VERSION\}"' "runtime_packages_not_version_pinned"
require_pattern package/Dockerfile 'runtime-ubuntu-packages\.tsv' "runtime_resolved_package_manifest_missing"
require_pattern package/Dockerfile '/var/log/alternatives\.log /var/log/lastlog /var/log/faillog /var/cache/ldconfig/aux-cache' "runtime_nondeterministic_state_not_removed"
require_pattern package/Dockerfile 'USER 10001:10001' "runtime_user_not_nonroot"
require_pattern package/Dockerfile 'setcap cap_net_bind_service=\+ep /usr/bin/resource-scheduler' "scheduler_capability_missing"
require_pattern package/Dockerfile 'org\.opencontainers\.image\.source="https://github\.com/PastureStack/resource-scheduler"' "oci_source_missing"
require_pattern package/Dockerfile 'org\.opencontainers\.image\.revision="\$\{IMAGE_REVISION\}"' "oci_revision_missing"
require_pattern scripts/package '^[[:space:]]*--load[[:space:]]*\\$' "runtime_image_not_loaded"
require_pattern scripts/package '--tag "\$\{IMAGE\}"' "runtime_image_tag_missing"
require_pattern scripts/package '--build-arg SOURCE_DATE_EPOCH="\$\{SOURCE_DATE_EPOCH\}"' "source_date_epoch_missing"
require_pattern scripts/package 'UBUNTU_SNAPSHOT=\$\{UBUNTU_SNAPSHOT:-20260808T000000Z\}' "package_snapshot_not_current"
require_pattern .dockerignore '^!bin/resource-scheduler$' "verified_binary_not_in_context"
require_pattern .dockerignore '^!ubuntu-apt\.lock$' "apt_lock_not_in_build_context"
require_pattern .dockerignore '^!toolchain/buildx-security\.patch$' "buildx_patch_not_in_build_context"
require_pattern toolchain/buildx-security.patch '^\+	"crypto/rand"$' "buildx_crypto_random_patch_missing"
require_pattern toolchain/buildx-security.patch '^-	"github\.com/docker/docker/pkg/namesgenerator"$' "buildx_namesgenerator_removal_missing"
require_pattern ubuntu-apt.lock '^UBUNTU_APT_SNAPSHOT=.20260808T000000Z.$' "apt_snapshot_lock_missing"
require_pattern ubuntu-apt.lock '^UBUNTU_APT_GCC_VERSION=.4:15\.2\.0-5ubuntu1.$' "gcc_package_lock_missing"
require_pattern go.mod '^go 1\.27\.0$' "go_module_version_not_current"
require_pattern go.mod 'github\.com/go-viper/mapstructure/v2 v2\.5\.0' "mapstructure_v2_not_current"
require_pattern go.mod 'github\.com/sirupsen/logrus v1\.10\.1' "logrus_not_current"
require_pattern go.mod 'github\.com/urfave/cli/v3 v3\.11\.0' "cli_v3_not_current"
require_pattern go.mod 'golang\.org/x/sys v0\.47\.0' "x_sys_not_current"
reject_pattern Dockerfile.dapper 'GO111MODULE=' "legacy_go111module_present"
require_pattern .github/workflows/repository-integrity.yml 'repository-integrity\.yml@86986b855e3cde8bab6b5221407417365ef138a4' "reusable_workflow_not_commit_pinned"
reject_pattern .github/workflows/repository-integrity.yml 'repository-integrity\.yml@main' "reusable_workflow_floating"
require_pattern .github/workflows/supply-chain.yml 'actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1' "checkout_action_not_commit_pinned"
require_pattern .github/workflows/supply-chain.yml 'actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a' "artifact_action_not_commit_pinned"
require_pattern .github/workflows/supply-chain.yml 'aquasec/trivy:0\.74\.0@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969' "trivy_image_not_digest_pinned"
require_pattern .github/workflows/supply-chain.yml 'govulncheck@v1\.1\.4' "govulncheck_not_version_pinned"
require_pattern .github/workflows/supply-chain.yml "stat -c '%u:%g' bin/resource-scheduler" "output_ownership_gate_missing"
require_pattern .github/workflows/supply-chain.yml 'diff -u toolchain/buildx-security\.patch evidence/buildx-security\.patch' "buildx_patch_evidence_missing"
require_pattern .github/workflows/supply-chain.yml '9d424e752f24ea0e34ccd80340428f067ae8109204c401c93786a2b0be6ea993  evidence/buildx-security\.patch' "buildx_patch_evidence_sha_missing"
require_pattern .github/workflows/supply-chain.yml "vex_expires='2026-09-15T00:00:00Z'" "builder_vex_expiry_missing"
reject_pattern .github/workflows/supply-chain.yml 'sudo[[:space:]]+rm' "privileged_cleanup_present"
require_pattern scripts/entry 'trap restore_output_ownership EXIT' "output_ownership_trap_missing"
require_pattern scripts/entry 'chown -R "\$uid:\$gid" "\$\{outputs\[@\]\}"' "targeted_output_chown_missing"
reject_pattern scripts/entry 'chown -R .* \.' "checkout_wide_chown_present"
reject_pattern scripts/entry 'exec[[:space:]]' "entry_exec_bypasses_cleanup"

require_pattern package/update-pasturestack-ca 'CATTLE_CA_CHECKSUM#sha256:' "ca_checksum_prefix_not_supported"
require_pattern package/update-pasturestack-ca 'sha256sum "\$\{cert_file\}"' "ca_checksum_not_verified"
require_pattern package/update-pasturestack-ca '--connect-timeout "\$\{curl_connect_timeout\}"' "ca_connect_timeout_missing"
require_pattern package/update-pasturestack-ca '--max-time "\$\{curl_max_time\}"' "ca_max_time_missing"
reject_pattern package/update-pasturestack-ca 'curl .*-[A-Za-z]*k' "insecure_ca_download"
reject_pattern package/Dockerfile 'gmail\.com|users\.noreply\.github\.com|C:\\Users|/Users/' "personal_marker_in_image"

echo "failure_count=${failures}"
if [ "${failures}" -ne 0 ]; then
    exit 1
fi

echo "RESOURCE_SCHEDULER_BUILD_POLICY_OK go=1.27.0 docker=29.7.2 buildx=0.36.1 pinned_base=1 pinned_direct_apt=1 module_vendor=1 buildx_legacy_module_removed=1 output_ownership_restored=1 reproducible_export=1 nonroot=1 verified_ca=1"
