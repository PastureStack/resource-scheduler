#!/usr/bin/env python3
"""Exercise the packaged process against disposable control-plane fixtures."""
import http.server
import json
import subprocess
import sys
import threading
import time
import urllib.parse


available = threading.Event()
available.set()


class Fixture(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        status = 200 if available.is_set() else 503
        value = {"data": []}
        if path == "/2016-07-29/version":
            value = "smoke-revision-1"
            if urllib.parse.urlsplit(self.path).query:
                time.sleep(0.1)
        elif path in ("/2016-07-29/hosts", "/2016-07-29/containers"):
            value = []
        elif path == "/ping":
            value = "pong"
        elif path != "/v2-beta":
            status = 404
        body = json.dumps(value).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        if path == "/v2-beta":
            self.send_header("X-API-Schemas", base_url)
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def docker(*arguments, check=True):
    return subprocess.run(
        ["docker", *arguments], check=check, text=True, capture_output=True, timeout=30
    )


def response(container, path):
    result = docker(
        "exec", container, "curl", "--silent", "--show-error", "--max-time", "5",
        "--output", "/dev/null", "--write-out", "%{http_code}",
        "http://127.0.0.1" + path, check=False,
    )
    return result.stdout


server = http.server.ThreadingHTTPServer(("0.0.0.0", 0), Fixture)
server.daemon_threads = True
base_url = f"http://fixture:{server.server_port}/v2-beta"
thread = threading.Thread(target=server.serve_forever, daemon=True)
thread.start()
container = None
try:
    image = sys.argv[1]
    assert docker("image", "inspect", "--format", "{{.Config.User}}", image).stdout.strip() == "10001:10001"
    container = docker(
        "run", "--detach", "--add-host", "fixture:host-gateway",
        "--env", "NO_PROXY=fixture,127.0.0.1", "--env", "no_proxy=fixture,127.0.0.1",
        "--env", f"CATTLE_URL={base_url}",
        "--env", "CATTLE_ACCESS_KEY=smoke-fixture", "--env", "CATTLE_SECRET_KEY=smoke-fixture",
        "--env", f"PASTURESTACK_METADATA_ADDRESS=fixture:{server.server_port}", image,
    ).stdout.strip()
    for _ in range(30):
        if response(container, "/healthcheck") == "200" and response(container, "/readiness") == "200":
            break
        time.sleep(1)
    else:
        raise AssertionError("packaged scheduler never became live and ready")
    assert docker("exec", container, "id", "-u").stdout.strip() == "10001"
    assert "cap_net_bind_service=ep" in docker("exec", container, "getcap", "/usr/bin/resource-scheduler").stdout
    assert response(container, "/healthcheck") == "200"
    available.clear()
    assert response(container, "/readiness") == "503"
    assert response(container, "/healthcheck") == "200"
    assert docker("inspect", "--format", "{{.RestartCount}}", container).stdout.strip() == "0"
    print("RESOURCE_SCHEDULER_RUNTIME_SMOKE_OK nonroot=10001 port=80 capability=present ready=200 dependency_failure=503 liveness=200 restart_count=0")
except BaseException:
    if container:
        print(docker("logs", container, check=False).stderr, file=sys.stderr)
    raise
finally:
    if container:
        docker("rm", "--force", container, check=False)
    server.shutdown()
    server.server_close()
