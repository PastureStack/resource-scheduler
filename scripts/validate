#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "Running go vet"
go vet -mod=vendor ./...
go list -mod=vendor ./... >/dev/null
echo "Running gofmt"
unformatted=$(find . -name '*.go' -not -path './vendor/*' -not -path './.git/*' -not -path './bin/*' -print0 | xargs -0 gofmt -l -s)
if [ -n "${unformatted}" ]; then
    printf '%s\n' "${unformatted}" >&2
    exit 1
fi
test -f go.mod
test -f go.sum
test -f vendor/modules.txt
test ! -e trash.conf
test ! -e vendor.lock
